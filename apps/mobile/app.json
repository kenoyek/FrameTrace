{
  "expo": {
    "name": "FrameTrace",
    "slug": "frametrace",
    "scheme": "frametrace",
    "version": "0.1.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "app.frametrace.mobile"
    },
    "android": {
      "package": "app.frametrace.mobile",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-image-picker",
        {
          "photosPermission": "Choose a video to identify its source.",
          "microphonePermission": "Record sound with your video. Nothing is uploaded until you tap Identify.",
          "cameraPermission": "Record a short video to review and identify its source."
        }
      ],
      "expo-video",
      "./plugins/with-native-share.cjs",
      "expo-status-bar"
    ]
  }
}
