# Non-secret configuration. Use real project settings only in an ignored local env file.
FRAMETRACE_SUPABASE_URL=https://your-project.supabase.co
FRAMETRACE_STORAGE_BACKEND=local
# For private R2 query storage, set backend=s3, endpoint, bucket and usable server-only
# S3 signing credentials through an approved runtime secret/file binding.
# FRAMETRACE_S3_ENDPOINT_URL=https://your-account-id.r2.cloudflarestorage.com
# FRAMETRACE_S3_BUCKET=frametrace-private-queries
# Never put an S3 secret key, service-role key, or real password in this example or Git.
